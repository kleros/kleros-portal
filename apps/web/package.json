{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "tsc --noEmit",
    "test": "TZ=UTC NODE_OPTIONS=--no-experimental-webstorage LANG=en_US.UTF-8 vitest run",
    "test:watch": "TZ=UTC NODE_OPTIONS=--no-experimental-webstorage LANG=en_US.UTF-8 vitest",
    "test:coverage": "TZ=UTC NODE_OPTIONS=--no-experimental-webstorage LANG=en_US.UTF-8 vitest run --coverage",
    "test:mutation": "TZ=UTC NODE_OPTIONS=--no-experimental-webstorage LANG=en_US.UTF-8 stryker run",
    "test:e2e": "playwright test",
    "test:e2e:real-atlas": "playwright test -c playwright.real-atlas.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@kleros/kleros-app": "^3.1.0",
    "@kleros/ui-components-library": "^3.10.0",
    "@reown/appkit": "^1.8.22",
    "@reown/appkit-adapter-wagmi": "^1.8.22",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.3",
    "@wagmi/core": "^3.6.3",
    "clsx": "^2.1.1",
    "graphql": "^16.9.0",
    "graphql-request": "^7.4.0",
    "jose": "^5.10.0",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.4.2",
    "viem": "^2.55.4",
    "wagmi": "^3.7.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@kleros-portal/eslint-config": "workspace:*",
    "@kleros-portal/mock-atlas": "workspace:*",
    "@kleros-portal/prettier-config": "workspace:*",
    "@kleros-portal/typescript-config": "workspace:*",
    "@next/env": "14.2.35",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.28.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.7.4",
    "typescript": "^5.8.3",
    "vite": "^7",
    "vite-plugin-svgr": "^4",
    "vitest": "^4.1.0"
  },
  "prettier": "@kleros-portal/prettier-config",
  "volta": {
    "extends": "../../package.json"
  }
}
